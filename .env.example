# Acesso ao site inteiro é bloqueado por HTTP Basic Auth (src/middleware.ts)
# até essas duas variáveis serem definidas. Sem elas, o acesso falha fechado
# (ninguém entra) — não deixe a hospedagem sem configurar isso.
SITE_AUTH_USER=
SITE_AUTH_PASSWORD=

# As variáveis abaixo estão preparadas para a evolução futura com Supabase
# (autenticação, banco de dados e armazenamento em nuvem) e não são lidas
# pelo código ainda. Os dados de análises e relatórios de IA continuam
# armazenados localmente (localStorage) nesta versão.

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
