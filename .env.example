# Kylian+Movic não requer variáveis de ambiente na primeira versão (MVP).
# Os dados de análises e relatórios de IA são armazenados localmente (localStorage).
#
# As variáveis abaixo estão preparadas para a evolução futura com Supabase
# (autenticação, banco de dados e armazenamento em nuvem) e não são lidas
# pelo código ainda.

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
